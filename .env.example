# --- LabCheck Server & Database (Turso LibSQL / Lokal) ---
# Kosongkan TURSO_DATABASE_URL untuk otomatis memakai SQLite lokal (file:./local.db) saat dev
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=
JWT_SECRET=ganti-dengan-random-secret-minimal-32-karakter
PORT=8787

# --- Backend API ICLabs (dipakai LabCheck Sync & script CLI rekap-peserta.mjs) ---
ICLABS_BASE_URL=https://iclabs.fikom.umi.ac.id/api/v1

# --- Khusus CLI rekap-peserta.mjs (opsional; di Web LabCheck diinput on-demand) ---
ICLABS_IDENTITAS=
ICLABS_PASSWORD=
ICLABS_NAMA_PERANGKAT=rekap-peserta
ICLABS_PERIODE=
ICLABS_CSV_DELIMITER=;
